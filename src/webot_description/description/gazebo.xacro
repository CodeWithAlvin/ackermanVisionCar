<?xml version="1.0" encoding="utf-8"?>

<robot name="ackerman_simple" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ========================================================
       MATERIAL REFERENCES (Gazebo visual colours)
  ========================================================= -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <gazebo reference="FL_WHEEL_LINK">
    <material>Gazebo/Black</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="FR_WHEEL_LINK">
    <material>Gazebo/Black</material>
    <mu1>0.8</mu1>
    <mu2>0.8</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="BL_WHEEL_LINK">
    <material>Gazebo/Black</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="BR_WHEEL_LINK">
    <material>Gazebo/Black</material>
    <mu1>0.9</mu1>
    <mu2>0.9</mu2>
    <kp>1e6</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
  </gazebo>

  <gazebo reference="CAMERA_LINK">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo reference="CAMERA_LINK">
    <sensor name="camera_sensor" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>

      <!-- gz topic for raw image data -->
      <topic>/camera/image</topic>

      <camera>
        <horizontal_fov>1.3962634</horizontal_fov>   <!-- ~80 degrees -->
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    
    </sensor>
  </gazebo>


  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <!-- Path to ros2_controllers.yaml loaded by the controller manager -->
      <parameters>$(find webot_description)/config/ros2_controllers.yaml</parameters>
      <!-- Namespace for the controller manager node -->
      <ros>
        <namespace>/</namespace>
      </ros>
    </plugin>
  </gazebo>

</robot>